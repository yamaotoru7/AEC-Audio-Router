<Window x:Class="AecAudioRouter.ListenBackWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AecAudioRouter"
    Title="聞き返し" Width="680" SizeToContent="Height" MinWidth="460"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize"
    Background="#111418" Foreground="#F0F2F4" FontFamily="Yu Gothic UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>
    <StackPanel Margin="24,20,24,18">
        <TextBlock x:Name="Headline" Text="停止前の 30 秒" Style="{StaticResource Heading}"/>
        <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,16"
            Text="処理前はエコー除去とノイズ除去をかける前のマイクの音、処理後はマイクの出力先に送った音です。緑の枠の方が聞こえます。もう一方をクリックすると、同じ位置のまま切り替わります。"/>
        <DockPanel Margin="0,0,0,4">
            <Button x:Name="PlayButton" Click="PlayClick" Content="▶ 再生 (_P)" MinWidth="104"
                Style="{StaticResource Primary}" IsDefault="True"
                ToolTip="Windows の既定の出力デバイスで再生します。"/>
            <TextBlock x:Name="TimeText" DockPanel.Dock="Right" Style="{StaticResource Readout}"
                Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
            <TextBlock x:Name="DeviceText" Style="{StaticResource Caption}" Margin="12,0,8,0" VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        </DockPanel>
        <RadioButton x:Name="BeforeLane" Style="{StaticResource Lane}" GroupName="ListenBack" Margin="0,8,0,0"
            Checked="LaneChecked" PreviewMouseLeftButtonDown="LaneMouseDown"
            AutomationProperties.Name="処理前（マイク入力）を聞く"
            ToolTip="選ばれているときにクリックすると、その位置から再生します。">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource LaneNote}"/>
                    <TextBlock FontSize="13"><Run Text="マイク入力"/><Run Text="（処理前）" Foreground="{StaticResource Muted}" FontSize="12"/></TextBlock>
                </DockPanel>
                <local:WaveformView x:Name="BeforeWave" Height="56" Margin="0,5,0,0"/>
            </StackPanel>
        </RadioButton>
        <RadioButton x:Name="AfterLane" Style="{StaticResource Lane}" GroupName="ListenBack" Margin="0,8,0,0"
            Checked="LaneChecked" PreviewMouseLeftButtonDown="LaneMouseDown"
            AutomationProperties.Name="処理後（出力）を聞く"
            ToolTip="選ばれているときにクリックすると、その位置から再生します。">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource LaneNote}"/>
                    <TextBlock FontSize="13"><Run Text="出力"/><Run Text="（処理後）" Foreground="{StaticResource Muted}" FontSize="12"/></TextBlock>
                </DockPanel>
                <local:WaveformView x:Name="AfterWave" Height="56" Margin="0,5,0,0"/>
            </StackPanel>
        </RadioButton>
        <DockPanel Margin="0,18,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Click="CloseClick" Content="閉じる" MinWidth="78" IsCancel="True"/>
        </DockPanel>
    </StackPanel>
</Window>
