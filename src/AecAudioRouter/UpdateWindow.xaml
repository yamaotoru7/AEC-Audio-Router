<Window x:Class="AecAudioRouter.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="アップデート" Width="580" Height="470" MinWidth="420" MinHeight="320"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
    Background="#111418" Foreground="#F0F2F4" FontFamily="Yu Gothic UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="Headline" Style="{StaticResource Heading}" TextWrapping="Wrap"/>
            <TextBlock x:Name="Subline" Style="{StaticResource Caption}" Margin="0,5,0,14"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="Notes" TextWrapping="Wrap" FontSize="13" LineHeight="21"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="ProgressText" Grid.Row="2" Style="{StaticResource Caption}" Margin="0,12,0,0"
            AutomationProperties.LiveSetting="Polite"/>
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Left" Click="OpenPage" Content="リリースページ"/>
            <Button x:Name="InstallButton" DockPanel.Dock="Right" Click="InstallClick" Content="更新して再起動" MinWidth="130"
                Style="{StaticResource Primary}" IsDefault="True"/>
            <Button x:Name="LaterButton" DockPanel.Dock="Right" Click="LaterClick" Content="後で" MinWidth="78" Margin="0,0,8,0" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
